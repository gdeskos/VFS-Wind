<?xml version="1.0" encoding="UTF-8"?>
<!--
  VFS-Wind Configuration File
  Test Case: 3D Sloshing

  This XML configuration is equivalent to the legacy control.dat file.
  Usage: mpirun -np 4 ./vwis -xml control.xml
-->
<vfswind version="1.0">

  <!-- Simulation Control -->
  <simulation>
    <timestep dt="0.001" totalsteps="100" output_interval="100"/>
    <restart enabled="0" timestep="0"/>
    <options delete_previous="0" second_order="1" laplacian="1" averaging="0"/>
  </simulation>

  <!-- Physics Parameters -->
  <physics>
    <reynolds_number>6666.6666</reynolds_number>
    <gravity x="0.0" y="-9.8" z="0.0"/>
  </physics>

  <!-- Turbulence Modeling (disabled for sloshing) -->
  <turbulence>
    <les enabled="0" model="smagorinsky" max_cs="0.2"/>
    <rans enabled="0" model="k-omega-sst"/>
    <wall_function enabled="0"/>
  </turbulence>

  <!-- Level Set (Two-Phase Flow) -->
  <levelset enabled="1" sloshing="2" surface_tension="0"
            level_in="2" level_in_height="1.0" dthick="0.03"
            tau="0.05" subdt="4" air_flow="0" fix_level="0">
    <!-- fluid0 = water (heavy fluid), fluid1 = air (light fluid) -->
    <fluid0 density="1000" viscosity="1.0e-3"/>
    <fluid1 density="1" viscosity="1.8e-5"/>
    <iterations>15</iterations>
  </levelset>

  <!-- Solver Settings -->
  <solvers>
    <poisson type="1" iterations="15" tolerance="5e-9"/>
    <momentum implicit="4" max_iterations="50" tolerance="1.0e-5"/>
  </solvers>

  <!-- Parallel/Domain Settings -->
  <parallel>
    <periodic i="0" j="0" k="0"/>
  </parallel>

  <!-- Output Settings -->
  <!-- VTK output disabled - use ./data post-processor to convert binaries to VTK -->
  <output>
    <path>./</path>
    <vtk enabled="0"/>
    <binary enabled="0"/>
  </output>

  <!-- Grid and Boundary Files -->
  <grid file="grid.dat" format="xyz"/>
  <boundaries file="bcs.dat"/>

  <!-- Immersed Boundary (disabled) -->
  <immersed_boundary enabled="0" bodies="1"/>

</vfswind>
