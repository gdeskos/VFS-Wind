<?xml version="1.0" encoding="UTF-8"?>
<!--
  VFS-Wind Configuration File
  Test Case: Vortex-Induced Vibration (VIV) of Mounted Cylinder

  This simulates a cylinder mounted on a spring in cross-flow, free to
  oscillate in the Y-direction due to vortex shedding.

  Physical parameters:
    - Reynolds number: 150 (based on cylinder diameter)
    - Reduced velocity: U_red = 6 (U / (f_n * D))
    - Mass ratio: m* = 0.25 (m / (rho * D^2))
    - Damping ratio: 0.0 (undamped)

  Usage: mpirun -np 4 ./vwis -xml control.xml
-->
<vfswind version="1.0">

  <!-- Simulation Control -->
  <simulation>
    <timestep dt="0.01" totalsteps="6000" output_interval="500"/>
    <restart enabled="0" timestep="0"/>
    <options delete_previous="0" second_order="1" laplacian="0" averaging="0"/>
  </simulation>

  <!-- Physics Parameters -->
  <physics>
    <reynolds_number>150</reynolds_number>
    <gravity x="0.0" y="0.0" z="-9.81"/>
  </physics>

  <!-- Turbulence Modeling (disabled for low Re) -->
  <turbulence>
    <les enabled="0" model="smagorinsky" max_cs="0.2"/>
    <rans enabled="0" model="k-omega-sst"/>
    <wall_function enabled="0"/>
  </turbulence>

  <!-- Level Set (disabled - single phase flow) -->
  <levelset enabled="0">
    <fluid0 density="1000" viscosity="1.0e-3"/>
    <fluid1 density="1.2" viscosity="1.8e-5"/>
    <iterations>20</iterations>
  </levelset>

  <!-- Solver Settings -->
  <solvers>
    <poisson type="1" iterations="50" tolerance="1.0e-9"/>
    <momentum implicit="4" max_iterations="50" tolerance="1.0e-5"/>
  </solvers>

  <!-- Parallel/Domain Settings -->
  <parallel>
    <periodic i="0" j="0" k="0"/>
  </parallel>

  <!-- Output Settings -->
  <output>
    <path>./</path>
    <vtk enabled="0"/>
    <binary enabled="0"/>
  </output>

  <!-- Grid and Boundary Files -->
  <grid file="grid.dat" format="xyz"/>
  <boundaries file="bcs.dat"/>

  <!-- Immersed Boundary with FSI -->
  <immersed_boundary enabled="1" bodies="1"/>

  <!-- Fluid-Structure Interaction -->
  <fsi enabled="1" forced_motion="0" fall_cylinder="0">
    <!-- Cylinder center position -->
    <center x="0.0" y="8.0" z="8.0"/>
    <!-- Degrees of freedom: only Y (cross-flow) is free -->
    <dof x="0" y="1" z="0"/>
    <!-- Structural parameters -->
    <!-- reduced_velocity = 2*pi / U_red_actual, here U_red = 6 -->
    <parameters reduced_velocity="1.047197551196597746154214461"
                damping="0.0"
                mass_ratio="0.25"/>
  </fsi>

  <!-- Channel Flow Settings (inlet enabled) -->
  <channel_flow enabled="0" inlet="1"/>

</vfswind>
