<?xml version="1.0" encoding="UTF-8"?>
<!--
  VFS-Wind Configuration File
  Test Case: 2D Falling Cylinder

  This simulates a cylinder falling under gravity through a two-phase
  fluid using the Level Set method for interface tracking.

  Physical parameters:
    - Reynolds number: 10 (based on cylinder diameter and settling velocity)
    - Gravity: -1 m/s^2 (Z-direction)
    - Density ratio: 1000:1 (heavy fluid : light fluid)
    - Mass ratio: m* = 0.25

  Usage: mpirun -np 4 ./vwis -xml control.xml
-->
<vfswind version="1.0">

  <!-- Simulation Control -->
  <simulation>
    <timestep dt="0.01" totalsteps="500" output_interval="125"/>
    <restart enabled="0" timestep="0"/>
    <options delete_previous="0" second_order="0" laplacian="1" averaging="0"/>
  </simulation>

  <!-- Physics Parameters -->
  <physics>
    <reynolds_number>10</reynolds_number>
    <gravity x="0.0" y="0.0" z="-1.0"/>
  </physics>

  <!-- Turbulence Modeling (disabled for low Re) -->
  <turbulence>
    <les enabled="0" model="smagorinsky" max_cs="0.2"/>
    <rans enabled="0" model="k-omega-sst"/>
    <wall_function enabled="0"/>
  </turbulence>

  <!-- Level Set (Two-Phase Flow) -->
  <levelset enabled="1" sloshing="0" surface_tension="0"
            level_in="1" level_in_height="0.0" dthick="0.04"
            tau="0.05" air_flow="0" fix_level="0">
    <!-- fluid0 = heavy fluid (density=1), fluid1 = light fluid (density=0.001) -->
    <fluid0 density="1" viscosity="1.0e-3"/>
    <fluid1 density="0.001" viscosity="1.8e-5"/>
    <iterations>10</iterations>
  </levelset>

  <!-- Solver Settings -->
  <solvers>
    <poisson type="1" iterations="30" tolerance="1.0e-6"/>
    <momentum implicit="4" max_iterations="50" tolerance="1.0e-6"/>
  </solvers>

  <!-- Parallel/Domain Settings -->
  <parallel>
    <periodic i="0" j="0" k="0"/>
  </parallel>

  <!-- Output Settings -->
  <output>
    <path>./</path>
    <vtk enabled="0"/>
    <binary enabled="1"/>
  </output>

  <!-- Grid and Boundary Files -->
  <grid file="grid.dat" format="binary"/>
  <boundaries file="bcs.dat"/>

  <!-- Immersed Boundary with FSI -->
  <immersed_boundary enabled="1" bodies="1"/>

  <!-- Fluid-Structure Interaction - Falling Cylinder -->
  <fsi enabled="1" forced_motion="1" fall_cylinder="1">
    <!-- Cylinder center position -->
    <center x="0.0" y="0.0" z="1.25"/>
    <!-- Degrees of freedom: ay (acceleration in y) -->
    <dof ay="1"/>
    <!-- Structural parameters -->
    <parameters reduced_velocity="0.897597901025655210"
                damping="0.0"
                mass_ratio="0.25"/>
  </fsi>

  <!-- Channel Flow Settings (inlet disabled) -->
  <channel_flow enabled="0" inlet="0"/>

</vfswind>
